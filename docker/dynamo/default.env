###############################################################################
#                                ↓ REQUIRED ↓                                 #
###############################################################################
# 用户文件夹所在的工作目录，用于挂载到容器内, 末尾不要加斜杠
WORKSPACE=/data

# 用户名，用于创建用户组和对应的用户文件夹
USER=xxx

# SSH连接容器密码, 用于远程连接容器(容器内为root)
ROOT_PASS=xxx
# Notebook连接容器密码, 用于远程连接容器
NOTEBOOK_PASS=xxx

###############################################################################
#                                ↓ OPTIONAL ↓                                 #
###############################################################################
# 是否添加透明代理, 任意值都会添加透明代理, 保留空值则不添加透明代理
TRANSPARENT_PROXY=

# JFrog Artifactory URL, 例如: https://host.docker.internal:443
ARTIFACTORY_URL=https://host.docker.internal:443

# Docker Registry URL, 例如: jfrog.local.com/docker/
# 注意末尾的斜杠
DOCKER_DOMAIN=

# JFrog Artifactory Virtual Repository Key Prefix, 例如填写ai, 则对应的本地源为 ai-conda, ai-pypi 等
# 如果不填写, 则默认的本地源为 conda, pypi 等
REPOSITORY_KEY_PREFIX=

# 镜像Tag
IMAGE_TAG__VLLM=

# 端口信息, 不要使用 VLLM_ 前缀(.env 会注入容器, vLLM 会读取 VLLM_* 环境变量)
DYNAMO_SSH_PORT=
DYNAMO_NOTEBOOK_PORT=
DYNAMO_EXTRA_PORT_1=
DYNAMO_EXTRA_PORT_2=
DYNAMO_EXTRA_PORT_3=
